# ============================================
# Dockerfile for Client App (React CRA)
# Multi-stage: build then serve with nginx
# ============================================

# --- Stage 1: Build ---
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY Client/package.json Client/package-lock.json ./

# Install all dependencies (including devDependencies for build)
RUN npm ci --legacy-peer-deps

# Copy source code
COPY Client/ ./

# Set environment variables for build
# API URL uses relative path so it works with nginx reverse proxy
ENV REACT_APP_API_URL=
ENV REACT_APP_API_BASE_URL=
ENV PUBLIC_URL=/app

# Build the React app
RUN npm run build

# --- Stage 2: Serve with nginx ---
FROM nginx:alpine

# Copy custom nginx config for SPA routing
COPY production-build/nginx-client.conf /etc/nginx/conf.d/default.conf

# Copy build output
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
