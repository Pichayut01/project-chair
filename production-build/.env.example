# ============================================
#  Echair Production Environment Variables
#  Copy this file to .env and fill in values
#  Usage: copy .env.example .env
# ============================================

# ─── MongoDB ───
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_to_secure_password

# MongoDB connection string (ใช้ username/password เดียวกับด้านบน)
MONGODB_URI=mongodb://admin:change_me_to_secure_password@mongodb:27017/myreactdb?authSource=admin

# ─── Server ───
JWT_SECRET=change_me_to_random_secret_string
NODE_ENV=production

# ─── Email (สำหรับ Password Reset) ───
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── Client URL (ใช้ใน email templates) ───
# เปลี่ยนเป็น domain จริงของคุณ
CLIENT_URL=http://localhost/app

# ─── Firebase ───
# Path ไปยังไฟล์ Firebase Service Account JSON
# ถ้าไม่ระบุจะใช้ ./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Nginx ───
# Port ที่ต้องการให้แอปรันบน host (default: 80)
NGINX_PORT=80
