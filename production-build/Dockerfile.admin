# ============================================
# Dockerfile for Admin Panel (Static HTML)
# ============================================
FROM nginx:alpine

# Copy static HTML files
COPY admin/index.html /usr/share/nginx/html/
COPY admin/simple-settings.html /usr/share/nginx/html/
COPY admin/test-db.html /usr/share/nginx/html/

# Copy default nginx config for static serving
COPY production-build/nginx-admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
