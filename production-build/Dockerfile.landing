# ============================================
# Dockerfile for Landing Page (Vite React)
# Multi-stage: build then serve with nginx
# ============================================

# --- Stage 1: Build ---
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY landing-page-app/package.json landing-page-app/package-lock.json ./

# Install all dependencies (including devDependencies for build)
RUN npm ci

# Copy source code
COPY landing-page-app/ ./

# Build the Vite app
RUN npm run build

# --- Stage 2: Serve with nginx ---
FROM nginx:alpine

# Copy custom nginx config for SPA routing
COPY production-build/nginx-landing.conf /etc/nginx/conf.d/default.conf

# Copy build output (Vite outputs to dist/)
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
